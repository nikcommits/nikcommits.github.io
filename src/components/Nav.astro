---
import { siteConfig } from "../config/site";
type Props = { lang?: "de" | "ar" };
const { lang = "de" } = Astro.props;
const isArabic = lang === "ar";
const labels = isArabic
  ? ["الترجمة", "الترجمة الشفوية", "الطلبات", "الخطوات"]
  : siteConfig.nav.map((item) => item.label);
const logoAlt = isArabic
  ? "شعار شاكر للاستشارات، مكتب ترجمة عربي ألماني. مُنشأ بالذكاء الاصطناعي."
  : "Logo von Shaker Consulting, Übersetzungsbüro Arabisch–Deutsch. Mit KI generiert.";
const aiLabel = isArabic ? "مُنشأ بالذكاء الاصطناعي" : "Mit KI generiert";
---
<header class="site-header">
  <div class="container nav-wrap">
    <a class="wordmark" href={isArabic ? "/ar" : "/"} aria-label={isArabic ? "شاكر للاستشارات – الصفحة الرئيسية" : "Shaker Consulting – Startseite"}>
      <img
        src="/brand/shaker-consulting-logo-480.webp"
        srcset="/brand/shaker-consulting-logo-480.webp 480w, /brand/shaker-consulting-logo-960.webp 960w"
        sizes="220px"
        alt={logoAlt}
        width="480"
        height="160"
        data-ai-generated="true"
      />
      <span class="ai-media-label wordmark-ai-label">{aiLabel}</span>
    </a>
    <nav class="desktop-nav" aria-label={isArabic ? "التنقل الرئيسي" : "Hauptnavigation"}>
      {siteConfig.nav.map((item, index) => <a href={item.href}>{labels[index]}</a>)}
      <a class="language" href={isArabic ? "/" : "/ar"}>{isArabic ? "DE" : "العربية"}</a>
      <a class="nav-cta" href={siteConfig.whatsapp} target="_blank" rel="noreferrer">{isArabic ? "واتساب" : "WhatsApp"}</a>
    </nav>
    <div class="mobile-actions">
      <a class="mobile-language" href={isArabic ? "/" : "/ar"} aria-label={isArabic ? "Zur deutschen Seite wechseln" : "Zur arabischen Seite wechseln"}>{isArabic ? "DE" : "العربية"}</a>
      <details class="mobile-menu">
        <summary>{isArabic ? "القائمة" : "Menü"}<span aria-hidden="true"></span></summary>
        <nav aria-label={isArabic ? "التنقل للهاتف" : "Mobile Navigation"}>
          {siteConfig.nav.map((item, index) => <a href={item.href}>{labels[index]}</a>)}
          <a class="nav-cta" href={siteConfig.whatsapp} target="_blank" rel="noreferrer">{isArabic ? "واتساب" : "WhatsApp"}</a>
        </nav>
      </details>
    </div>
  </div>
</header>
<script is:inline>
  document.querySelectorAll(".mobile-menu").forEach((menu) => {
    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
    menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => { menu.open = false; }));
  });
</script>
