---
// src/components/zibg/AccessGate.astro
interface Props {
  basePath?: string;
}

const { basePath = './' } = Astro.props;
const logoSrc = `${basePath}zibg-logo.svg`;
---

<div class="access-gate" id="access-gate">
  <form class="access-box" id="access-form">
    <img class="brand-logo brand-logo--access" src={logoSrc} alt="ZIBG – Zentrum für Islamische Bildung und Gemeinschaft Krefeld" width="165" height="165" />
    <h1>Interner Bereich</h1>
    <p>Bitte gib den Zugangscode ein, um die Vorstandsinformationen zu öffnen.</p>
    <p class="access-error" id="access-error" role="alert" hidden>Der eingegebene Zugangscode ist nicht richtig.</p>
    <label for="access-code">Zugangscode</label>
    <input id="access-code" name="access-code" type="password" autocomplete="current-password" required autofocus />
    <button type="submit">Seite öffnen</button>
    <p class="access-note">ZIBG e.V. · Geschützter Zugriff</p>
  </form>
</div>

<script is:inline>
  (function () {
    const accessHash = '8ea22477221e40c13a1ae12d84cf897769b4aa60e247c98a735c51feb60e415a';
    const accessStorageKey = 'zibg_access_until';
    const accessDuration = 12 * 60 * 60 * 1000;

    async function sha256(value) {
      const bytes = new TextEncoder().encode(value);
      const digest = await crypto.subtle.digest('SHA-256', bytes);
      return Array.from(new Uint8Array(digest), byte => byte.toString(16).padStart(2, '0')).join('');
    }

    function openSite() {
      const accessGate = document.querySelector('#access-gate');
      const protectedSite = document.querySelector('#protected-site');
      if (accessGate) accessGate.hidden = true;
      if (protectedSite) protectedSite.hidden = false;
      document.body.style.overflow = '';
    }

    function initGate() {
      const accessForm = document.querySelector('#access-form');
      const accessCode = document.querySelector('#access-code');
      const accessError = document.querySelector('#access-error');

      if (Number(localStorage.getItem(accessStorageKey) || 0) > Date.now()) {
        openSite();
      } else {
        localStorage.removeItem(accessStorageKey);
        document.body.style.overflow = 'hidden';
      }

      if (accessForm && accessCode) {
        accessForm.addEventListener('submit', async event => {
          event.preventDefault();
          if (accessError) accessError.hidden = true;
          if (await sha256(accessCode.value) === accessHash) {
            localStorage.setItem(accessStorageKey, String(Date.now() + accessDuration));
            accessCode.value = '';
            openSite();
          } else {
            if (accessError) accessError.hidden = false;
            accessCode.select();
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGate);
    } else {
      initGate();
    }
  })();
</script>
