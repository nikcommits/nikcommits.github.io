---
// src/components/zibg/sections/AufgabenTeaser.astro
---

<section id="aufgaben-teaser" aria-labelledby="teaser-title">
  <div class="card board-teaser-card">
    <div class="board-teaser-content">
      <div>
        <p class="kicker">Vorstands-Organisation</p>
        <h2 id="teaser-title" style="font-size: clamp(24px, 3.5vw, 32px);">Aufgaben- & Kanban-Board</h2>
        <p class="muted" style="max-width: 680px; margin-top: 8px;">
          Strukturiertes Board für <strong>Abdul Aziz</strong>, <strong>Engin</strong>, <strong>Mahmoud</strong> und <strong>Sammy</strong>. Alle 14 Vorstandsaufgaben mit Drag & Drop, Zuständigkeiten, Fortschrittsanzeige und 1-Klick-Export für die WhatsApp-Gruppe.
        </p>
      </div>

      <div class="board-teaser-actions">
        <a class="button-link board-open-btn" href="./aufgaben/">
          <span>👉 Zum Aufgaben-Board (14 Aufgaben) ↗</span>
        </a>
      </div>
    </div>

    <div class="board-teaser-stats" id="teaser-stats-wrap">
      <div class="board-teaser-stats-head">
        <span>Aktueller Bearbeitungsstand</span>
        <strong id="teaser-stats-headline">0 von 14 Aufgaben erledigt (0 %)</strong>
      </div>
      <div class="board-progress-bar" style="margin-bottom: 0;">
        <div class="board-progress-fill" id="teaser-progress-fill" style="width: 0%;"></div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const STORAGE_KEY = 'zibg_kanban_tasks_v1';
    function updateTeaser() {
      const headline = document.querySelector('#teaser-stats-headline');
      const fill = document.querySelector('#teaser-progress-fill');
      if (!headline || !fill) return;

      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          const tasks = JSON.parse(saved);
          if (Array.isArray(tasks) && tasks.length > 0) {
            const done = tasks.filter(t => t.defaultStatus === 'done').length;
            const total = tasks.length;
            const pct = Math.round((done / total) * 100);
            headline.textContent = `${done} von ${total} Aufgaben erledigt (${pct} %)`;
            fill.style.width = `${pct}%`;
            return;
          }
        }
      } catch (e) {
        console.error(e);
      }
      headline.textContent = '0 von 14 Aufgaben erledigt (0 %)';
      fill.style.width = '0%';
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateTeaser);
    } else {
      updateTeaser();
    }
  })();
</script>
