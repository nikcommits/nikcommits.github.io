---
// src/components/zibg/sections/Beitragsrechner.astro
---

<section id="rechner" aria-labelledby="rechner-title">
  <div class="section-head">
    <p class="kicker">04 · Beitragsrechner</p>
    <h2 id="rechner-title">Was bringt das Modell monatlich?</h2>
  </div>
  <div class="card calc">
    <label>Verifizierte zahlende Mitglieder
      <input id="members" type="number" inputmode="numeric" min="0" max="500" value="16" />
    </label>
    <label>Monatliche Rate in Euro
      <input id="rate" type="number" inputmode="decimal" min="0" max="1000" step="1" value="20" />
    </label>
    <div class="result" aria-live="polite"><span>Monatliche Beitragseinnahmen</span><strong id="income">320 €</strong><span id="gap">Zur Miete fehlen 330 €.</span></div>
  </div>
</section>

<script is:inline>
  const members = document.querySelector('#members');
  const rate = document.querySelector('#rate');
  const income = document.querySelector('#income');
  const gap = document.querySelector('#gap');
  const rent = 650;
  const euro = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });

  function updateCalculator() {
    if (!members || !rate || !income || !gap) return;
    const total = Math.max(0, Number(members.value) || 0) * Math.max(0, Number(rate.value) || 0);
    income.textContent = euro.format(total);
    const difference = rent - total;
    gap.textContent = difference > 0 ? `Zur Miete fehlen ${euro.format(difference)}.` : `Die Miete ist gedeckt; Überschuss ${euro.format(Math.abs(difference))}.`;
  }

  if (members && rate) {
    members.addEventListener('input', updateCalculator);
    rate.addEventListener('input', updateCalculator);
    updateCalculator();
  }
</script>
