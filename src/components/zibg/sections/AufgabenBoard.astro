---
// src/components/zibg/sections/AufgabenBoard.astro
import { initialZibgTasks, ZIBG_MEMBERS } from '../../../data/zibg-sections';

interface Props {
  isStandalone?: boolean;
}

const { isStandalone = false } = Astro.props;
---

<section id="aufgaben" aria-labelledby="aufgaben-title" class="board-section" style={isStandalone ? "margin-top: 0;" : ""}>
  <div class="section-head" style={isStandalone ? "display: none;" : ""}>
    <p class="kicker">Vorstands-Dashboard · Aufgaben & Zuständigkeiten</p>
    <h2 id="aufgaben-title">Aufgaben gemeinsam abarbeiten</h2>
    <p class="muted">
      Hier kann der Vorstand Aufgaben flexibel anlegen, bearbeiten, per Drag & Drop oder Klick zuweisen, erledigte Aufgaben bereinigen und den aktuellen Stand für WhatsApp exportieren.
    </p>
  </div>

  <!-- Progress & Stats Card -->
  <div class="card board-stats-card" id="board-stats">
    <div class="board-stats-header">
      <div>
        <span class="board-stats-caption">Gesamtfortschritt</span>
        <strong class="board-stats-headline" id="board-total-stats">0 Aufgaben erledigt (0 %)</strong>
      </div>
      <div class="board-actions">
        <button type="button" class="board-btn board-btn--primary" id="board-add-task-btn">
          <span>➕ Neue Aufgabe</span>
        </button>
        <button type="button" class="board-btn" id="board-manage-members-btn">
          <span>👥 Personen verwalten</span>
        </button>
        <button type="button" class="board-btn board-btn--danger" id="board-clear-done-btn" title="Alle als erledigt markierten Aufgaben endgültig löschen">
          <span>🗑️ Erledigte löschen</span>
        </button>
        <button type="button" class="button-link whatsapp-btn" id="board-whatsapp-btn">
          <span>📲 Für WhatsApp kopieren</span>
        </button>
        <button type="button" class="board-reset-btn" id="board-reset-btn" title="Aufgaben & Personen auf Standard zurücksetzen">
          ↺ Zurücksetzen
        </button>
      </div>
    </div>

    <!-- Progress Bar -->
    <div class="board-progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="board-progress-bar">
      <div class="board-progress-fill" id="board-progress-fill" style="width: 0%;"></div>
    </div>

    <!-- Per-Member Stats (Dynamic via JS) -->
    <div class="board-members-grid" id="board-members-stats">
      {ZIBG_MEMBERS.map(member => (
        <div class="board-member-stat" data-member-stat={member}>
          <span class="board-member-badge" data-member-name={member}>{member}</span>
          <strong class="board-member-count" data-member-count={member}>0 / 0</strong>
        </div>
      ))}
    </div>
  </div>

  <!-- Filter Bar -->
  <div class="board-filter-wrap" role="toolbar" aria-label="Aufgaben nach Person filtern">
    <span class="board-filter-label">Filter nach Person:</span>
    <div class="board-filter-pills" id="board-filter-pills">
      <button type="button" class="board-pill active" data-filter="all">Alle (<span id="count-all">0</span>)</button>
    </div>
  </div>

  <!-- Kanban Board Container -->
  <div class="kanban-grid" id="kanban-grid">
    <!-- Column: Offen -->
    <div class="kanban-col" data-col="todo" id="col-todo">
      <div class="kanban-col-head kanban-col-head--todo">
        <span class="kanban-dot dot--todo"></span>
        <h3>Offen</h3>
        <span class="kanban-count" id="count-todo">0</span>
      </div>
      <div class="kanban-list" id="list-todo" data-dropzone="todo"></div>
    </div>

    <!-- Column: In Bearbeitung -->
    <div class="kanban-col" data-col="in-progress" id="col-in-progress">
      <div class="kanban-col-head kanban-col-head--progress">
        <span class="kanban-dot dot--progress"></span>
        <h3>In Bearbeitung</h3>
        <span class="kanban-count" id="count-in-progress">0</span>
      </div>
      <div class="kanban-list" id="list-in-progress" data-dropzone="in-progress"></div>
    </div>

    <!-- Column: Erledigt -->
    <div class="kanban-col" data-col="done" id="col-done">
      <div class="kanban-col-head kanban-col-head--done">
        <span class="kanban-dot dot--done"></span>
        <h3>Erledigt</h3>
        <button type="button" class="col-action-clear-btn" id="col-clear-done-btn" title="Alle erledigten Aufgaben löschen">🗑️ Leeren</button>
        <span class="kanban-count" id="count-done">0</span>
      </div>
      <div class="kanban-list" id="list-done" data-dropzone="done"></div>
    </div>
  </div>

  <!-- Modal: Neue Aufgabe hinzufügen -->
  <div class="board-modal-backdrop" id="modal-new-task" hidden>
    <div class="board-modal" role="dialog" aria-labelledby="modal-task-title" aria-modal="true">
      <div class="board-modal-head">
        <h3 id="modal-task-title">➕ Neue Vorstandsaufgabe</h3>
        <button type="button" class="board-modal-close" data-close-modal="modal-new-task" aria-label="Schließen">✕</button>
      </div>
      <form id="form-new-task" class="board-modal-body">
        <div class="form-group">
          <label for="new-task-title">Titel der Aufgabe <span class="required">*</span></label>
          <input type="text" id="new-task-title" required placeholder="z. B. Freistellungsbescheid beim Finanzamt anfordern" />
        </div>
        <div class="form-group">
          <label for="new-task-desc">Beschreibung / Details</label>
          <textarea id="new-task-desc" rows="3" placeholder="Optionale Notizen, Fristen oder Verwendungszwecke..."></textarea>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="new-task-cat">Kategorie</label>
            <input type="text" id="new-task-cat" list="cat-suggestions" placeholder="z. B. Finanzen & Bank" />
            <datalist id="cat-suggestions">
              <option value="Mitglieder & Verwaltung" />
              <option value="Recht & Satzung" />
              <option value="Finanzen & Bank" />
              <option value="Software & IT" />
              <option value="Fundraising" />
              <option value="Allgemein" />
            </datalist>
          </div>
          <div class="form-group">
            <label for="new-task-assignee">Zuständige Person</label>
            <select id="new-task-assignee"></select>
          </div>
        </div>
        <div class="form-group">
          <label for="new-task-status">Start-Status</label>
          <select id="new-task-status">
            <option value="todo" selected>📋 Offen</option>
            <option value="in-progress">⏳ In Bearbeitung</option>
            <option value="done">✅ Erledigt</option>
          </select>
        </div>
        <div class="board-modal-footer">
          <button type="button" class="board-btn" data-close-modal="modal-new-task">Abbrechen</button>
          <button type="submit" class="board-btn board-btn--primary">Aufgabe anlegen</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Personen verwalten -->
  <div class="board-modal-backdrop" id="modal-manage-members" hidden>
    <div class="board-modal" role="dialog" aria-labelledby="modal-member-title" aria-modal="true">
      <div class="board-modal-head">
        <h3 id="modal-member-title">👥 Personen & Zuständige verwalten</h3>
        <button type="button" class="board-modal-close" data-close-modal="modal-manage-members" aria-label="Schließen">✕</button>
      </div>
      <div class="board-modal-body">
        <p class="muted" style="margin-top: 0; font-size: 13px;">
          Füge neue Vorstandsmitglieder oder Helfer hinzu oder entferne Personen aus der Auswahl.
        </p>

        <form id="form-add-member" class="add-member-form">
          <input type="text" id="new-member-name" required placeholder="Name der Person (z. B. Bilal)" />
          <button type="submit" class="board-btn board-btn--primary"><span>+ Hinzufügen</span></button>
        </form>

        <div class="member-list-label">Aktuelle Personen:</div>
        <div class="members-management-list" id="members-management-list">
          <!-- Dynamically populated -->
        </div>
      </div>
      <div class="board-modal-footer">
        <button type="button" class="board-btn" data-close-modal="modal-manage-members">Fertig</button>
      </div>
    </div>
  </div>

  <!-- Toast Notice -->
  <div class="board-toast" id="board-toast" role="status" aria-live="polite" hidden>
    <span id="board-toast-text">✓ Erfolgreich ausgeführt</span>
  </div>
</section>

<!-- Raw Data for Client Script -->
<script is:inline define:vars={{ initialZibgTasks, ZIBG_MEMBERS }}>
  (function () {
    const TASKS_STORAGE_KEY = 'zibg_kanban_tasks_v1';
    const MEMBERS_STORAGE_KEY = 'zibg_kanban_members_v1';
    let currentFilter = 'all';

    function loadMembers() {
      try {
        const saved = localStorage.getItem(MEMBERS_STORAGE_KEY);
        if (saved) {
          let parsed = JSON.parse(saved);
          if (Array.isArray(parsed) && parsed.length > 0) {
            // Migrate Sammy -> Samih
            parsed = parsed.map(m => m === 'Sammy' ? 'Samih' : m);
            // Ensure newly added members from meeting (e.g. Samih, Inan, Hassib) are present
            ZIBG_MEMBERS.forEach(m => {
              if (!parsed.includes(m)) parsed.push(m);
            });
            localStorage.setItem(MEMBERS_STORAGE_KEY, JSON.stringify(parsed));
            return parsed;
          }
        }
      } catch (e) {
        console.error('Error loading members:', e);
      }
      return [...ZIBG_MEMBERS];
    }

    function saveMembers() {
      try {
        localStorage.setItem(MEMBERS_STORAGE_KEY, JSON.stringify(members));
      } catch (e) {
        console.error('Error saving members:', e);
      }
    }

    function loadTasks() {
      try {
        const saved = localStorage.getItem(TASKS_STORAGE_KEY);
        if (saved) {
          let parsed = JSON.parse(saved);
          if (Array.isArray(parsed)) {
            // Migrate old tasks defaultAssignee Sammy -> Samih
            parsed.forEach(t => {
              if (t.defaultAssignee === 'Sammy') t.defaultAssignee = 'Samih';
            });

            // Automatically merge newly added meeting tasks that aren't in storage yet
            const existingIds = new Set(parsed.map(t => t.id));
            const newMeetingTasks = initialZibgTasks.filter(t => !existingIds.has(t.id));
            if (newMeetingTasks.length > 0) {
              parsed.unshift(...newMeetingTasks);
              localStorage.setItem(TASKS_STORAGE_KEY, JSON.stringify(parsed));
            }
            return parsed;
          }
        }
      } catch (e) {
        console.error('Error loading tasks:', e);
      }
      return JSON.parse(JSON.stringify(initialZibgTasks));
    }

    function saveTasks() {
      try {
        localStorage.setItem(TASKS_STORAGE_KEY, JSON.stringify(tasks));
      } catch (e) {
        console.error('Error saving tasks:', e);
      }
    }

    let members = loadMembers();
    let tasks = loadTasks();

    function showToast(message) {
      const toast = document.querySelector('#board-toast');
      const toastText = document.querySelector('#board-toast-text');
      if (!toast) return;
      if (toastText) toastText.textContent = message;
      toast.hidden = false;
      clearTimeout(window.__boardToastTimer);
      window.__boardToastTimer = setTimeout(() => {
        toast.hidden = true;
      }, 3500);
    }

    function escapeHtml(str) {
      return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function renderBoard() {
      const listTodo = document.querySelector('#list-todo');
      const listProgress = document.querySelector('#list-in-progress');
      const listDone = document.querySelector('#list-done');

      if (!listTodo || !listProgress || !listDone) return;

      listTodo.innerHTML = '';
      listProgress.innerHTML = '';
      listDone.innerHTML = '';

      let todoCount = 0;
      let progressCount = 0;
      let doneCount = 0;

      const memberCounts = {};
      members.forEach(m => {
        memberCounts[m] = { total: 0, done: 0 };
      });

      tasks.forEach(task => {
        const assignee = task.defaultAssignee || members[0] || 'Engin';
        if (!memberCounts[assignee]) {
          memberCounts[assignee] = { total: 0, done: 0 };
        }
        memberCounts[assignee].total++;
        if (task.defaultStatus === 'done') {
          memberCounts[assignee].done++;
        }

        if (task.defaultStatus === 'todo') todoCount++;
        else if (task.defaultStatus === 'in-progress') progressCount++;
        else if (task.defaultStatus === 'done') doneCount++;

        // Filter check
        if (currentFilter !== 'all' && assignee !== currentFilter) {
          return;
        }

        const card = document.createElement('article');
        card.className = `kanban-card kanban-card--${task.defaultStatus}`;
        card.setAttribute('data-task-id', task.id);
        card.setAttribute('draggable', 'true');

        card.innerHTML = `
          <div class="kanban-card-top">
            <span class="kanban-tag">${escapeHtml(task.category || 'Allgemein')}</span>
            <div class="kanban-card-actions">
              <div class="kanban-assignee-wrap">
                <label for="assignee-${task.id}" class="sr-only">Zuständig</label>
                <select class="kanban-assignee-select" id="assignee-${task.id}" data-action="assign" data-id="${task.id}">
                  ${members.map(m => `<option value="${escapeHtml(m)}" ${m === assignee ? 'selected' : ''}>${escapeHtml(m)}</option>`).join('')}
                </select>
              </div>
              <button type="button" class="kanban-card-del-btn" data-action="delete" data-id="${task.id}" title="Aufgabe endgültig löschen" aria-label="Aufgabe löschen">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
              </button>
            </div>
          </div>
          <h4 class="kanban-card-title">${escapeHtml(task.title)}</h4>
          ${task.description ? `<p class="kanban-card-desc">${escapeHtml(task.description)}</p>` : ''}
          <div class="kanban-card-footer">
            <div class="kanban-status-controls">
              <button type="button" class="kanban-status-btn ${task.defaultStatus === 'todo' ? 'is-active' : ''}" data-status="todo" data-id="${task.id}" title="Als Offen markieren">📋 Offen</button>
              <button type="button" class="kanban-status-btn ${task.defaultStatus === 'in-progress' ? 'is-active' : ''}" data-status="in-progress" data-id="${task.id}" title="Als In Arbeit markieren">⏳ In Arbeit</button>
              <button type="button" class="kanban-status-btn ${task.defaultStatus === 'done' ? 'is-active' : ''}" data-status="done" data-id="${task.id}" title="Als Erledigt markieren">✅ Erledigt</button>
            </div>
          </div>
        `;

        // Native Drag & Drop Handlers
        card.addEventListener('dragstart', e => {
          e.dataTransfer.setData('text/plain', task.id);
          card.classList.add('is-dragging');
          setTimeout(() => card.style.opacity = '0.4', 0);
        });

        card.addEventListener('dragend', () => {
          card.classList.remove('is-dragging');
          card.style.opacity = '1';
          document.querySelectorAll('.kanban-col').forEach(c => c.classList.remove('drag-over'));
        });

        if (task.defaultStatus === 'todo') listTodo.appendChild(card);
        else if (task.defaultStatus === 'in-progress') listProgress.appendChild(card);
        else if (task.defaultStatus === 'done') listDone.appendChild(card);
      });

      // Update counters
      const elCountTodo = document.querySelector('#count-todo');
      const elCountProgress = document.querySelector('#count-in-progress');
      const elCountDone = document.querySelector('#count-done');
      const elCountAll = document.querySelector('#count-all');

      if (elCountTodo) elCountTodo.textContent = String(todoCount);
      if (elCountProgress) elCountProgress.textContent = String(progressCount);
      if (elCountDone) elCountDone.textContent = String(doneCount);
      if (elCountAll) elCountAll.textContent = String(tasks.length);

      // Progress bar & Total stats
      const total = tasks.length;
      const pct = total > 0 ? Math.round((doneCount / total) * 100) : 0;
      const totalStatsEl = document.querySelector('#board-total-stats');
      const progressFill = document.querySelector('#board-progress-fill');
      const progressBar = document.querySelector('#board-progress-bar');

      if (totalStatsEl) {
        totalStatsEl.textContent = `${doneCount} von ${total} Aufgaben erledigt (${pct} %)`;
      }
      if (progressFill) {
        progressFill.style.width = `${pct}%`;
      }
      if (progressBar) {
        progressBar.setAttribute('aria-valuenow', String(pct));
      }

      // Update Member Stats Grid
      const membersStatsGrid = document.querySelector('#board-members-stats');
      if (membersStatsGrid) {
        membersStatsGrid.innerHTML = members.map(m => {
          const stats = memberCounts[m] || { total: 0, done: 0 };
          return `
            <div class="board-member-stat" data-member-stat="${escapeHtml(m)}">
              <span class="board-member-badge">${escapeHtml(m)}</span>
              <strong class="board-member-count">${stats.done} / ${stats.total} erledigt</strong>
            </div>
          `;
        }).join('');
      }

      // Update Filter Pills
      const filterPillsContainer = document.querySelector('#board-filter-pills');
      if (filterPillsContainer) {
        let pillsHtml = `
          <button type="button" class="board-pill ${currentFilter === 'all' ? 'active' : ''}" data-filter="all">
            Alle (<span id="count-all">${tasks.length}</span>)
          </button>
        `;
        members.forEach(m => {
          const count = (memberCounts[m] ? memberCounts[m].total : 0);
          pillsHtml += `
            <button type="button" class="board-pill ${currentFilter === m ? 'active' : ''}" data-filter="${escapeHtml(m)}">
              ${escapeHtml(m)} (<span>${count}</span>)
            </button>
          `;
        });
        filterPillsContainer.innerHTML = pillsHtml;
      }

      // Update New Task Modal Assignee Select Options
      const newTaskAssigneeSelect = document.querySelector('#new-task-assignee');
      if (newTaskAssigneeSelect) {
        newTaskAssigneeSelect.innerHTML = members.map(m => `
          <option value="${escapeHtml(m)}">${escapeHtml(m)}</option>
        `).join('');
      }
    }

    function renderMembersManager() {
      const listEl = document.querySelector('#members-management-list');
      if (!listEl) return;
      listEl.innerHTML = members.map(m => {
        const count = tasks.filter(t => t.defaultAssignee === m).length;
        return `
          <div class="member-manage-item">
            <div class="member-manage-item-info">
              <span class="board-member-badge">${escapeHtml(m)}</span>
              <span class="muted" style="font-size: 13px;">${count} Aufgabe(n)</span>
            </div>
            <button type="button" class="member-manage-del-btn" data-remove-member="${escapeHtml(m)}" title="Person entfernen">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
              Entfernen
            </button>
          </div>
        `;
      }).join('');
    }

    function clearDoneTasks() {
      const doneTasks = tasks.filter(t => t.defaultStatus === 'done');
      if (doneTasks.length === 0) {
        showToast('ℹ️ Keine erledigten Aufgaben vorhanden.');
        return;
      }
      const count = doneTasks.length;
      if (confirm(`Möchtest du wirklich alle ${count} erledigten Aufgaben unwiderruflich löschen?`)) {
        tasks = tasks.filter(t => t.defaultStatus !== 'done');
        saveTasks();
        renderBoard();
        renderMembersManager();
        showToast(`✓ ${count} erledigte Aufgabe(n) erfolgreich gelöscht!`);
      }
    }

    function deleteTask(id) {
      const task = tasks.find(t => t.id === id);
      if (!task) return;
      if (confirm(`Möchtest du die Aufgabe "${task.title}" wirklich löschen?`)) {
        tasks = tasks.filter(t => t.id !== id);
        saveTasks();
        renderBoard();
        renderMembersManager();
        showToast('✓ Aufgabe gelöscht!');
      }
    }

    function addMember(name) {
      const trimmed = name.trim();
      if (!trimmed) return;
      if (members.map(m => m.toLowerCase()).includes(trimmed.toLowerCase())) {
        alert('Diese Person existiert bereits in der Liste.');
        return;
      }
      members.push(trimmed);
      saveMembers();
      renderBoard();
      renderMembersManager();
      showToast(`✓ Person "${trimmed}" hinzugefügt!`);
    }

    function removeMember(name) {
      if (members.length <= 1) {
        alert('Es muss mindestens eine Person in der Liste bleiben.');
        return;
      }
      const taskCount = tasks.filter(t => t.defaultAssignee === name).length;
      const fallback = members.find(m => m !== name);
      const msg = taskCount > 0
        ? `Person "${name}" wirklich entfernen?\n${taskCount} Aufgabe(n) dieser Person werden auf "${fallback}" übertragen.`
        : `Person "${name}" wirklich aus der Vorstandsliste entfernen?`;

      if (!confirm(msg)) return;

      tasks.forEach(t => {
        if (t.defaultAssignee === name) {
          t.defaultAssignee = fallback;
        }
      });
      members = members.filter(m => m !== name);
      if (currentFilter === name) {
        currentFilter = 'all';
      }
      saveMembers();
      saveTasks();
      renderBoard();
      renderMembersManager();
      showToast(`✓ Person "${name}" entfernt!`);
    }

    function openModal(id) {
      const modal = document.querySelector(`#${id}`);
      if (modal) {
        modal.hidden = false;
        if (id === 'modal-manage-members') {
          renderMembersManager();
          const input = modal.querySelector('#new-member-name');
          if (input) setTimeout(() => input.focus(), 50);
        } else if (id === 'modal-new-task') {
          const input = modal.querySelector('#new-task-title');
          if (input) setTimeout(() => input.focus(), 50);
        }
      }
    }

    function closeModal(id) {
      const modal = document.querySelector(`#${id}`);
      if (modal) modal.hidden = true;
    }

    function initBoard() {
      // Drag & Drop onto Columns
      const columns = document.querySelectorAll('.kanban-col');
      columns.forEach(col => {
        col.addEventListener('dragover', e => {
          e.preventDefault();
          e.dataTransfer.dropEffect = 'move';
          col.classList.add('drag-over');
        });

        col.addEventListener('dragleave', () => {
          col.classList.remove('drag-over');
        });

        col.addEventListener('drop', e => {
          e.preventDefault();
          col.classList.remove('drag-over');
          const taskId = e.dataTransfer.getData('text/plain');
          const newStatus = col.getAttribute('data-col');
          if (taskId && newStatus) {
            const targetTask = tasks.find(t => t.id === taskId);
            if (targetTask && targetTask.defaultStatus !== newStatus) {
              targetTask.defaultStatus = newStatus;
              saveTasks();
              renderBoard();
            }
          }
        });
      });

      // Event Delegation for Buttons, Delete & Dropdowns inside Board
      const kanbanGrid = document.querySelector('#kanban-grid');
      if (kanbanGrid) {
        kanbanGrid.addEventListener('click', e => {
          // Status Buttons
          const btn = e.target.closest('[data-status]');
          if (btn) {
            const id = btn.getAttribute('data-id');
            const newStatus = btn.getAttribute('data-status');
            const targetTask = tasks.find(t => t.id === id);
            if (targetTask && targetTask.defaultStatus !== newStatus) {
              targetTask.defaultStatus = newStatus;
              saveTasks();
              renderBoard();
            }
            return;
          }

          // Single Task Delete
          const delBtn = e.target.closest('[data-action="delete"]');
          if (delBtn) {
            const id = delBtn.getAttribute('data-id');
            if (id) deleteTask(id);
            return;
          }
        });

        kanbanGrid.addEventListener('change', e => {
          const select = e.target.closest('[data-action="assign"]');
          if (select) {
            const id = select.getAttribute('data-id');
            const newAssignee = select.value;
            const targetTask = tasks.find(t => t.id === id);
            if (targetTask && targetTask.defaultAssignee !== newAssignee) {
              targetTask.defaultAssignee = newAssignee;
              saveTasks();
              renderBoard();
            }
          }
        });
      }

      // Filter Pills Click Delegation
      const filterPills = document.querySelector('#board-filter-pills');
      if (filterPills) {
        filterPills.addEventListener('click', e => {
          const pill = e.target.closest('[data-filter]');
          if (pill) {
            currentFilter = pill.getAttribute('data-filter') || 'all';
            renderBoard();
          }
        });
      }

      // Action Buttons
      const clearDoneBtn = document.querySelector('#board-clear-done-btn');
      if (clearDoneBtn) clearDoneBtn.addEventListener('click', clearDoneTasks);

      const colClearDoneBtn = document.querySelector('#col-clear-done-btn');
      if (colClearDoneBtn) colClearDoneBtn.addEventListener('click', clearDoneTasks);

      const addTaskBtn = document.querySelector('#board-add-task-btn');
      if (addTaskBtn) {
        addTaskBtn.addEventListener('click', () => openModal('modal-new-task'));
      }

      const manageMembersBtn = document.querySelector('#board-manage-members-btn');
      if (manageMembersBtn) {
        manageMembersBtn.addEventListener('click', () => openModal('modal-manage-members'));
      }

      // Modal Close Handlers (buttons & backdrop)
      document.querySelectorAll('[data-close-modal]').forEach(el => {
        el.addEventListener('click', () => {
          const modalId = el.getAttribute('data-close-modal');
          if (modalId) closeModal(modalId);
        });
      });

      document.querySelectorAll('.board-modal-backdrop').forEach(backdrop => {
        backdrop.addEventListener('click', e => {
          if (e.target === backdrop) {
            backdrop.hidden = true;
          }
        });
      });

      document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
          document.querySelectorAll('.board-modal-backdrop').forEach(m => m.hidden = true);
        }
      });

      // Form: New Task Submit
      const formNewTask = document.querySelector('#form-new-task');
      if (formNewTask) {
        formNewTask.addEventListener('submit', e => {
          e.preventDefault();
          const titleInput = document.querySelector('#new-task-title');
          const descInput = document.querySelector('#new-task-desc');
          const catInput = document.querySelector('#new-task-cat');
          const assigneeInput = document.querySelector('#new-task-assignee');
          const statusInput = document.querySelector('#new-task-status');

          if (!titleInput || !titleInput.value.trim()) return;

          const newTask = {
            id: 'task-' + Date.now(),
            title: titleInput.value.trim(),
            description: descInput ? descInput.value.trim() : '',
            category: (catInput && catInput.value.trim()) || 'Allgemein',
            defaultAssignee: (assigneeInput && assigneeInput.value) || members[0] || 'Engin',
            defaultStatus: (statusInput && statusInput.value) || 'todo',
          };

          tasks.unshift(newTask);
          saveTasks();
          renderBoard();
          closeModal('modal-new-task');
          formNewTask.reset();
          showToast('✓ Neue Aufgabe erfolgreich hinzugefügt!');
        });
      }

      // Form: Add Member Submit
      const formAddMember = document.querySelector('#form-add-member');
      if (formAddMember) {
        formAddMember.addEventListener('submit', e => {
          e.preventDefault();
          const input = document.querySelector('#new-member-name');
          if (input && input.value.trim()) {
            addMember(input.value.trim());
            input.value = '';
          }
        });
      }

      // Member Manager: Remove Member Click Delegation
      const membersManagementList = document.querySelector('#members-management-list');
      if (membersManagementList) {
        membersManagementList.addEventListener('click', e => {
          const btn = e.target.closest('[data-remove-member]');
          if (btn) {
            const memberName = btn.getAttribute('data-remove-member');
            if (memberName) removeMember(memberName);
          }
        });
      }

      // Reset Button
      const resetBtn = document.querySelector('#board-reset-btn');
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          if (confirm('Möchtest du alle Aufgaben und Personen auf den Ausgangszustand zurücksetzen?')) {
            localStorage.removeItem(TASKS_STORAGE_KEY);
            localStorage.removeItem(MEMBERS_STORAGE_KEY);
            tasks = JSON.parse(JSON.stringify(initialZibgTasks));
            members = [...ZIBG_MEMBERS];
            currentFilter = 'all';
            saveTasks();
            saveMembers();
            renderBoard();
            renderMembersManager();
            showToast('✓ Board auf Ausgangszustand zurückgesetzt.');
          }
        });
      }

      // WhatsApp Copy Export
      const whatsappBtn = document.querySelector('#board-whatsapp-btn');
      if (whatsappBtn) {
        whatsappBtn.addEventListener('click', async () => {
          const doneTasks = tasks.filter(t => t.defaultStatus === 'done');
          const progressTasks = tasks.filter(t => t.defaultStatus === 'in-progress');
          const todoTasks = tasks.filter(t => t.defaultStatus === 'todo');
          const total = tasks.length;
          const pct = total > 0 ? Math.round((doneTasks.length / total) * 100) : 0;

          let text = `*📊 ZIBG e.V. – Aufgaben- und Vorstandsstand*\n`;
          text += `Stand: ${new Date().toLocaleDateString('de-DE')} · ${doneTasks.length}/${total} erledigt (${pct}%)\n\n`;

          text += `*Zuständigkeiten Übersicht:*\n`;
          members.forEach(m => {
            const mTasks = tasks.filter(t => t.defaultAssignee === m);
            const mDone = mTasks.filter(t => t.defaultStatus === 'done').length;
            text += `• ${m}: ${mDone}/${mTasks.length} erledigt\n`;
          });

          if (progressTasks.length > 0) {
            text += `\n*⏳ Aktuell in Bearbeitung:*\n`;
            progressTasks.forEach(t => {
              text += `• [${t.defaultAssignee}] ${t.title}\n`;
            });
          }

          if (todoTasks.length > 0) {
            text += `\n*📋 Noch offen:*\n`;
            todoTasks.forEach(t => {
              text += `• [${t.defaultAssignee}] ${t.title}\n`;
            });
          }

          if (doneTasks.length > 0) {
            text += `\n*✅ Bereits erledigt:*\n`;
            doneTasks.forEach(t => {
              text += `• [${t.defaultAssignee}] ${t.title}\n`;
            });
          }

          text += `\n_Live-Vorstandsboard:_ https://nikcommits.github.io/zibg-vorstand/aufgaben/`;

          try {
            await navigator.clipboard.writeText(text);
            showToast('✓ WhatsApp-Text in die Zwischenablage kopiert!');
          } catch (err) {
            alert('Kopieren fehlgeschlagen: ' + err);
          }
        });
      }

      // Initial render
      renderBoard();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBoard);
    } else {
      initBoard();
    }
  })();
</script>
