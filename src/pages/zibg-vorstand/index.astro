---
// src/pages/zibg-vorstand/index.astro
import ZibgLayout from '../../layouts/ZibgLayout.astro';
import TableOfContents from '../../components/zibg/TableOfContents.astro';
import AufgabenTeaser from '../../components/zibg/sections/AufgabenTeaser.astro';
import Ausgangslage from '../../components/zibg/sections/Ausgangslage.astro';
import Zahlungen from '../../components/zibg/sections/Zahlungen.astro';
import Beschluss from '../../components/zibg/sections/Beschluss.astro';
import Beitragsrechner from '../../components/zibg/sections/Beitragsrechner.astro';
import ClubDesk from '../../components/zibg/sections/ClubDesk.astro';
import Betterplace from '../../components/zibg/sections/Betterplace.astro';
import NaechsteSchritte from '../../components/zibg/sections/NaechsteSchritte.astro';
import Faq from '../../components/zibg/sections/Faq.astro';
---

<ZibgLayout>
  <TableOfContents />
  <main class="wrap">
    <AufgabenTeaser />

    <!-- Latest Meeting Protocol Teaser -->
    <section id="protokolle-teaser" style="margin-top: 24px;">
      <div class="card" style="border-left: 4px solid var(--accent); background: var(--card); display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap;">
        <div style="max-width: 680px;">
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
            <span class="tag" style="background: var(--mint); color: var(--mint-text); border: 1px solid var(--mint-border);">Neues Protokoll</span>
            <span class="muted" style="font-size: 13px;">Sitzung vom 24.09.2026</span>
          </div>
          <h3 style="margin: 0 0 6px; font-size: 18.5px; color: var(--ink);">Verbindliche Neustrukturierung & Beschlüsse</h3>
          <p class="muted" style="margin: 0; font-size: 14px; line-height: 1.5;">
            Wöchentliches Status-Meeting (Do, 21:30 Uhr), Samih als handlungsfähiger Schatzmeister, Better Place Vorzug, digitale Vereinsablage und Kriterien für die Raumsuche (Gewerbe bis 700 €).
          </p>
        </div>
        <a href="./protokolle/" class="button-link primary-action-btn" style="white-space: nowrap;">
          <span>📝 Zum Sitzungsprotokoll ↗</span>
        </a>
      </div>
    </section>

    <Ausgangslage />
    <Zahlungen />
    <Beschluss />
    <Beitragsrechner />
    <ClubDesk />
    <Betterplace />
    <NaechsteSchritte />
    <Faq />

    <!-- Outsorced Statutes & Legal Reference Card -->
    <section id="satzung-referenz" style="margin-top: 48px;">
      <div class="card" style="display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; background: var(--card-alt); border: 1px solid var(--line);">
        <div style="max-width: 640px;">
          <span class="document-badge" style="background: var(--primary-light); color: #fff;">Archiv & Dokumentation</span>
          <h3 style="margin: 10px 0 6px; font-size: 18px; color: var(--ink);">Satzung & rechtliche Quellen</h3>
          <p class="muted" style="margin: 0; font-size: 14px; line-height: 1.5;">
            Die detaillierte Satzungslage, das vollständige Satzungsdokument als PDF-Vorschau und die BGB-Rechtsquellen wurden auf eine eigene Unterseite ausgelagert, um diese Übersicht übersichtlich und fokussiert zu halten.
          </p>
        </div>
        <a href="./satzung/" class="button-link" style="white-space: nowrap;">
          <span>📜 Zur Satzung & Dokumenten ↗</span>
        </a>
      </div>
    </section>
  </main>
</ZibgLayout>
