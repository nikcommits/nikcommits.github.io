---
// src/layouts/ZibgLayout.astro
import AccessGate from '../components/zibg/AccessGate.astro';
import { zibgNavItems, zibgBoardNavItems } from '../data/zibg-sections';
import '../styles/zibg.css';

interface Props {
  title?: string;
  description?: string;
  basePath?: string;
  isBoardPage?: boolean;
  heroEyebrow?: string;
  heroTitle?: string;
  heroLead?: string;
  heroStatus?: string;
}

const {
  title = 'ZIBG e.V. | Mitgliedsbeiträge und Vereinsverwaltung',
  description = 'Arbeitsstand des ZIBG e.V. zu Mitgliedsbeiträgen, bisherigen Zahlungen, ClubDesk, Betterplace-Registrierung und den nächsten Beschlüssen.',
  basePath = './',
  isBoardPage = false,
  heroEyebrow = 'Interner Arbeitsstand für den Vorstand',
  heroTitle = 'Mitgliedsbeiträge jetzt sauber ordnen.',
  heroLead = 'Ausgangslage, Satzungsregelung, bisherige Zahlungen und eine konkrete Empfehlung für ein einheitliches Beitragsmodell – kompakt an einem Ort.',
  heroStatus = 'Stand: 21. August 2026 · noch kein Beschluss',
} = Astro.props;

const logoPath = `${basePath}zibg-logo.svg`;
const manifestPath = `${basePath}manifest.json`;
const navItems = isBoardPage ? zibgBoardNavItems : zibgNavItems;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#212121" />
    <meta name="robots" content="noindex, nofollow, noarchive" />

    <!-- Web App & PWA / Home-Screen App Meta Tags -->
    <link rel="manifest" href={manifestPath} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="ZIBG Vorstand" />
    <link rel="apple-touch-icon" href={logoPath} />
    <link rel="icon" type="image/svg+xml" href={logoPath} />

    <title>{title}</title>
  </head>
  <body>
    <AccessGate basePath={basePath} />

    <div id="protected-site" hidden>
      <header>
        <div class="wrap nav">
          <a class="brand" href={isBoardPage ? '../index.html' : '#top'}>
            <img class="brand-logo brand-logo--nav" src={logoPath} alt="" width="44" height="44" />
            <span>ZIBG e.V.</span>
          </a>
          <nav aria-label="Seitennavigation">
            {navItems.map(item => (
              <a href={item.href}>{item.label}</a>
            ))}
          </nav>
        </div>
      </header>

      <div class="hero" id="top">
        <div class="wrap">
          <p class="eyebrow">{heroEyebrow}</p>
          <h1>{heroTitle}</h1>
          <p class="lead">{heroLead}</p>
          <div class="status"><span class="status-dot"></span>{heroStatus}</div>
        </div>
      </div>

      <slot />

      <footer>
        <div class="wrap">Zentrum für Islamische Bildung und Gemeinschaft in Krefeld e.V. · Interne Informationsseite · Arbeitsstand vom 21.08.2026</div>
      </footer>
    </div>
  </body>
</html>
