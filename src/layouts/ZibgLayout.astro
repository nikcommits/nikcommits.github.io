---
// src/layouts/ZibgLayout.astro
import AccessGate from '../components/zibg/AccessGate.astro';
import { zibgNavItems, zibgBoardNavItems } from '../data/zibg-sections';
import '../styles/zibg.css';

interface Props {
  title?: string;
  description?: string;
  basePath?: string;
  isBoardPage?: boolean;
  heroEyebrow?: string;
  heroTitle?: string;
  heroLead?: string;
  heroStatus?: string;
}

const {
  title = 'ZIBG e.V. | Mitgliedsbeiträge und Vereinsverwaltung',
  description = 'Arbeitsstand des ZIBG e.V. zu Mitgliedsbeiträgen, bisherigen Zahlungen, ClubDesk, Betterplace-Registrierung und den nächsten Beschlüssen.',
  basePath = './',
  isBoardPage = false,
  heroEyebrow = 'Interner Arbeitsstand für den Vorstand',
  heroTitle = 'Mitgliedsbeiträge jetzt sauber ordnen.',
  heroLead = 'Ausgangslage, Satzungsregelung, bisherige Zahlungen und eine konkrete Empfehlung für ein einheitliches Beitragsmodell – kompakt an einem Ort.',
  heroStatus = 'Stand: 21. August 2026 · noch kein Beschluss',
} = Astro.props;

const logoSvgPath = `${basePath}zibg-logo.svg`;
const appleTouchIconPath = `${basePath}apple-touch-icon.png`;
const icon192Path = `${basePath}icon-192.png`;
const manifestPath = `${basePath}manifest.json`;
const navItems = isBoardPage ? zibgBoardNavItems : zibgNavItems;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8fafc" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#090b10" />
    <meta name="robots" content="noindex, nofollow, noarchive" />

    <!-- Web App & PWA / Home-Screen App Meta Tags -->
    <link rel="manifest" href={manifestPath} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="ZIBG Vorstand" />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIconPath} />
    <link rel="icon" type="image/png" sizes="192x192" href={icon192Path} />
    <link rel="icon" type="image/svg+xml" href={logoSvgPath} />

    <title>{title}</title>
  </head>
  <body>
    <AccessGate basePath={basePath} />

    <div id="protected-site" hidden>
      <header>
        <div class="wrap nav">
          <a class="brand" href={isBoardPage ? '../index.html' : '#top'}>
            <img class="brand-logo brand-logo--nav" src={logoSvgPath} alt="" width="42" height="42" />
            <span>ZIBG e.V.</span>
          </a>

          <!-- Mobile Burger Button -->
          <button type="button" class="burger-btn" id="burger-btn" aria-label="Menü öffnen" aria-expanded="false" aria-controls="main-nav">
            <span class="burger-icon" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </span>
          </button>

          <!-- Navigation Links (Desktop & Mobile Drawer) -->
          <nav class="nav-links" id="main-nav" aria-label="Seitennavigation">
            {navItems.map(item => (
              <a href={item.href} class="nav-item-link">{item.label}</a>
            ))}
          </nav>
        </div>
      </header>

      <div class="hero" id="top">
        <div class="wrap">
          <p class="eyebrow">{heroEyebrow}</p>
          <h1>{heroTitle}</h1>
          <p class="lead">{heroLead}</p>
          <div class="status"><span class="status-dot"></span>{heroStatus}</div>
        </div>
      </div>

      <slot />

      <footer>
        <div class="wrap">Zentrum für Islamische Bildung und Gemeinschaft in Krefeld e.V. · Interne Informationsseite · Arbeitsstand vom 21.08.2026</div>
      </footer>
    </div>

    <!-- Burger Menu Script -->
    <script is:inline>
      (function () {
        function initMobileMenu() {
          const burgerBtn = document.querySelector('#burger-btn');
          const mainNav = document.querySelector('#main-nav');
          if (!burgerBtn || !mainNav) return;

          function toggleMenu(open) {
            const isExpanded = open !== undefined ? open : burgerBtn.getAttribute('aria-expanded') !== 'true';
            burgerBtn.setAttribute('aria-expanded', String(isExpanded));
            burgerBtn.setAttribute('aria-label', isExpanded ? 'Menü schließen' : 'Menü öffnen');
            mainNav.classList.toggle('is-open', isExpanded);
          }

          burgerBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            toggleMenu();
          });

          // Close on clicking any link inside
          mainNav.querySelectorAll('a').forEach(function (link) {
            link.addEventListener('click', function () {
              toggleMenu(false);
            });
          });

          // Close when clicking outside
          document.addEventListener('click', function (e) {
            if (mainNav.classList.contains('is-open') && !mainNav.contains(e.target) && !burgerBtn.contains(e.target)) {
              toggleMenu(false);
            }
          });

          // Close on Escape key
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && mainNav.classList.contains('is-open')) {
              toggleMenu(false);
              burgerBtn.focus();
            }
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initMobileMenu);
        } else {
          initMobileMenu();
        }
      })();
    </script>
  </body>
</html>
